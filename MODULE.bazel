# IFT Specification - for Feature Registry
http_archive(
    name = "ift_spec",
    build_file = "//third_party:ift_spec.BUILD",
    sha256 = "1871cace5fe85373ccc7fabc01849d4cd485f8e8c36010601a232ec84d1d170b",
    strip_prefix = "IFT-56e987829dec2866f7f2ad883e50791739c261cb",
