module(
    name = "ift_encoder",
    repo_name = "ift_encoder",
)

# Bazel Modules

bazel_dep(name = "rules_cc", version = "0.2.28")
bazel_dep(name = "rules_python", version = "2.5.1")
bazel_dep(name = "abseil-py", version = "2.4.0")

bazel_dep(name = "googletest", version = "1.18.0.bcr.1")
bazel_dep(name = "abseil-cpp", version = "20260817.0")
bazel_dep(name = "protobuf", version = "37.0-rc3")
bazel_dep(name = "riegeli", version = "0.0.0-20261117-64d553d")
bazel_dep(name = "platforms", version = "1.1.0")
bazel_dep(name = "rules_rust", version = "0.75.0")
bazel_dep(name = "glib", version = "2.84.4.bcr.2")
bazel_dep(name = "brotli", version = "1.2.1")
bazel_dep(name = "bazel_skylib", version = "1.9.2")

rules_python_config = use_extension("@rules_python//python/extensions:config.bzl", "config")
rules_python_config.explicit_init_py(default = True)

# Frequency Data
bazel_dep(name = "ift_encoder_data", version = "git")
git_override(module_name = "ift_encoder_data", remote = "https://github.com/w3c/ift-encoder-data.git", commit = "4d2f4f175c65e01dcb7ef2a8a326e9252e5831d6")

# Non Bazel Modules
http_archive = use_repo_rule("@bazel_tools//tools/build_defs/repo:http.bzl", "http_archive")
http_file = use_repo_rule("@bazel_tools//tools/build_defs/repo:http.bzl", "http_file")

# Unicode Data
http_file(
    name = "unicode_data",
    integrity = "sha256-BzZFHeQ5rnuvFCUTZhfaSV4J7lr75uOUN023AJ6giVA=",
    urls = ["https://www.unicode.org/Public/18.0.0/ucd/UnicodeData.txt"],
)

http_file(
    name = "derived_normalization_props",
    integrity = "sha256-mKx/Z9mF/ngeMX9hguiF6UyrsMMUdp5t1z5IsiaTHM0=",
    urls = ["https://www.unicode.org/Public/18.0.0/ucd/DerivedNormalizationProps.txt"],
)


