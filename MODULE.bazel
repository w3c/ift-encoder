    strip_prefix = "harfbuzz-71709df91cd8c97d49058c3437276f9d4c8e7285",
    integrity = "sha256-kRCuCHzHt5wXqmYs2nx1tVDWbTFfs79TX1RNMPdt1aA=",
    urls = ["https://github.com/harfbuzz/harfbuzz/archive/71709df91cd8c97d49058c3437276f9d4c8e7285.zip"],
)

# Base 32 Hex
